{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Investigation explanation requests processed per second.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(investigation_explanations_requests_total[5m]))",
          "instant": true,
          "legendFormat": "requests",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Explanation Request Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentage of requests served with a validated AI explanation.",
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(rate(investigation_explanations_ai_total[5m])) / clamp_min(sum(rate(investigation_explanations_requests_total[5m])), 0.001)",
          "instant": true,
          "legendFormat": "accepted",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "AI Acceptance Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentage of requests served by the deterministic fallback.",
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 50 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(rate(investigation_explanations_deterministic_total[5m])) / clamp_min(sum(rate(investigation_explanations_requests_total[5m])), 0.001)",
          "instant": true,
          "legendFormat": "fallback",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Deterministic Fallback Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Percentage of requests for which neither explanation source produced output.",
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(rate(investigation_explanations_unavailable_total[5m])) / clamp_min(sum(rate(investigation_explanations_requests_total[5m])), 0.001)",
          "instant": true,
          "legendFormat": "unavailable",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Unavailable Explanation Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Final explanation source selected for API responses.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(investigation_explanations_ai_total[5m]))", "legendFormat": "AI", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(investigation_explanations_deterministic_total[5m]))", "legendFormat": "Deterministic", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "sum(rate(investigation_explanations_unavailable_total[5m]))", "legendFormat": "Unavailable", "range": true, "refId": "C" }
      ],
      "title": "Final Explanation Outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Model responses rejected by deterministic output validation.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (validation_reason) (rate(investigation_ai_responses_invalid_total{provider=~\"$provider\",model=~\"$model\",prompt_version=~\"$prompt_version\"}[5m]))",
          "legendFormat": "{{validation_reason}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Invalid AI Responses by Reason",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Model requests that returned no structured response.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (provider, model) (rate(investigation_ai_responses_missing_total{provider=~\"$provider\",model=~\"$model\",prompt_version=~\"$prompt_version\"}[5m]))",
          "legendFormat": "{{provider}} / {{model}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Missing AI Responses",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Failed model attempts separated by operational classification.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (failure_type) (rate(investigation_ai_requests_failures_total{provider=~\"$provider\",model=~\"$model\",prompt_version=~\"$prompt_version\"}[5m]))",
          "legendFormat": "{{failure_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Failed AI Attempts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Retries and complete request timeouts affecting model communication.",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(investigation_ai_requests_retries_total{provider=~\"$provider\",model=~\"$model\",prompt_version=~\"$prompt_version\"}[5m]))", "legendFormat": "Retries", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(investigation_ai_requests_timeout_total{provider=~\"$provider\",model=~\"$model\",prompt_version=~\"$prompt_version\"}[5m]))", "legendFormat": "Timeouts", "range": true, "refId": "B" }
      ],
      "title": "Retries and Timeouts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Circuit-breaker state changes observed in the selected interval.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (from_state, to_state, provider, model) (increase(investigation_ai_circuit_transitions_total{provider=~\"$provider\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / {{model}}: {{from_state}} → {{to_state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Circuit Breaker Transitions",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["investigation-service", "ai"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(investigation_explanations_requests_total, provider)",
        "includeAll": true,
        "label": "Provider",
        "name": "provider",
        "query": { "query": "label_values(investigation_explanations_requests_total, provider)", "refId": "PrometheusVariableQueryEditor-Provider" },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(investigation_explanations_requests_total{provider=~\"$provider\"}, model)",
        "includeAll": true,
        "label": "Model",
        "name": "model",
        "query": { "query": "label_values(investigation_explanations_requests_total{provider=~\"$provider\"}, model)", "refId": "PrometheusVariableQueryEditor-Model" },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(investigation_explanations_ai_total{provider=~\"$provider\",model=~\"$model\"}, prompt_version)",
        "includeAll": true,
        "label": "Prompt version",
        "name": "prompt_version",
        "query": { "query": "label_values(investigation_explanations_ai_total{provider=~\"$provider\",model=~\"$model\"}, prompt_version)", "refId": "PrometheusVariableQueryEditor-Prompt" },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Investigation Service - AI",
  "uid": "investigation-service-ai-v1",
  "version": 1
}
