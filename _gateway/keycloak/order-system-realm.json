{
  "realm": "order-system",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,

  "clients": [
    {
      "clientId": "ordering-api",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "local-cli",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "customer-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "customer_id",
            "claim.name": "customer_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "false"
          }
        }
      ],
      "optionalClientScopes": [
        "orders.read",
        "orders.write",
        "investigations.read",
        "investigations.ask",
        "investigations.feedback"
      ],
      "defaultClientScopes": [
        "basic",
        "ordering-api-audience"
      ]
    }
  ],

  "clientScopes": [
    {
      "name": "orders.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "orders.write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "investigations.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "investigations.ask",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "investigations.feedback",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "ordering-api-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "ordering-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ordering-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "attributes": {
        "customer_id": [
          "22222222-2222-4222-8222-222222222222"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "alice-local-only",
          "temporary": false
        }
      ]
    }
  ]
}
